{
  "markdown.copyFiles.destination": {
    "/archive/**/*": "${documentWorkspaceFolder}/assets/${documentBaseName}/${fileName}",
    "/til/**/*": "${documentWorkspaceFolder}/assets/${documentBaseName}/${fileName}",
    "/knowledge/**/*": "${documentWorkspaceFolder}/assets/${documentBaseName}/${fileName}",
    "/practice/**/*": "${documentWorkspaceFolder}/assets/${documentBaseName}/${fileName}"
  },
  "markdown.editor.filePaste.copyIntoWorkspace": "mediaFiles",
  "markdown.copyFiles.overwriteBehavior": "nameIncrementally",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "deepml.solutionsDir": "challenges/deep-ml/solutions",
  "deepml.pythonPath": "${workspaceFolder}/.venv/bin/python",
  "r.executablePath": "${userHome}/.local/opt/mit1805/r/bin/R",
  "r.consolePath": "${userHome}/.local/opt/mit1805/r/bin/R",
  "r.consoleArgs": ["--no-save", "--no-restore"],
  "r.lsp.enabled": true,
  "r.sessionWatcher": true,
  "r.plot.backend": "standard"
}
