---
import Layout from '../../layouts/Layout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { AREAS, getNotes } from '../../lib/content';
import { withBase, noteUrl } from '../../lib/urls';
const notes = await getNotes();
const tags = [...new Set(notes.flatMap((note) => note.tags))].sort();
const searchable = notes.map(({ id, title, updated, tags, area, summary }) => ({ id, title, updated, tags, area, summary, url: noteUrl(id) }));
---
<Layout title="모든 문서">
  <div class="page-width library-page">
    <div class="page-intro"><p class="eyebrow">THE KNOWLEDGE LIBRARY</p><h1>다시 읽고, 이어서 이해하기.</h1><p>필요한 개념을 찾거나, 분야를 따라 천천히 둘러보세요.</p></div>
    <form id="library-form" class="library-controls" action={withBase('/knowledge/')}>
      <div class="search-form"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label class="sr-only" for="query">검색어</label><input id="query" name="q" type="search" placeholder="개념, 본문 또는 코드 식별자 검색" autocomplete="off"/><button type="submit">검색 →</button></div>
      <div class="filter-row">
        <div class="filter-group"><label for="area">분야</label><select id="area" name="area"><option value="">전체 분야</option>{AREAS.map((area) => <option value={area.id}>{area.label}</option>)}</select></div>
        <div class="filter-group"><label for="tag">태그</label><select id="tag" name="tag"><option value="">전체 태그</option>{tags.map((tag) => <option value={tag}>{tag}</option>)}</select></div>
        <div class="filter-group sort-group"><label for="sort">정렬</label><select id="sort" name="sort"><option value="updated">최근 수정순</option><option value="title">제목순</option></select></div>
        <a class="reset-filters" href={withBase('/knowledge/')}>초기화</a>
      </div>
    </form>
    <div class="results-heading"><h2>개념 문서</h2><p id="result-status" class="quiet" role="status" aria-live="polite">{notes.length}개의 문서</p></div>
    <div id="note-results" class="note-grid">{[...notes].sort((a, b) => b.updated.localeCompare(a.updated) || a.title.localeCompare(b.title, 'ko')).map((note) => <div data-note-id={note.id}><NoteCard note={note}/></div>)}</div>
    <div id="search-results" class="search-results" hidden></div>
    <div id="empty-results" class="empty-state" hidden><span aria-hidden="true">⌕</span><h2>일치하는 문서가 없습니다.</h2><p>다른 검색어를 사용하거나 분야·태그 필터를 줄여보세요.</p><a class="text-link" href={withBase('/knowledge/')}>전체 문서 보기 →</a></div>
    <noscript><p class="notice">본문 검색과 필터는 JavaScript가 필요합니다. 아래 전체 문서와 분야별 링크는 그대로 읽을 수 있습니다.</p></noscript>
  </div>
  <script is:inline id="note-data" type="application/json" set:html={JSON.stringify({ notes: searchable, base: withBase('/'), areas: AREAS }).replaceAll('<', '\\u003c')} />
  <script src="../../scripts/search.ts"></script>
</Layout>
